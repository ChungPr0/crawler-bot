#!/usr/bin/env bash
# ==============================================================================
# Hanoi IT Job Radar - Service Management CLI
# ==============================================================================
set -e

CONTAINER_NAME="hanoi-it-job-radar"

# Auto-detect docker execution permissions
DOCKER_CMD="docker"
if ! docker ps >/dev/null 2>&1; then
    if command -v sudo >/dev/null 2>&1 && sudo docker ps >/dev/null 2>&1; then
        DOCKER_CMD="sudo docker"
    fi
fi

is_container_running() {
    [ -n "$($DOCKER_CMD ps -q -f name=^/${CONTAINER_NAME}$)" ]
}

is_container_existing() {
    [ -n "$($DOCKER_CMD ps -a -q -f name=^/${CONTAINER_NAME}$)" ]
}

cmd_start() {
    if is_container_running; then
        echo "[INFO] Hanoi IT Job Radar service is already running."
        return 0
    fi

    if is_container_existing; then
        echo "[INFO] Starting Hanoi IT Job Radar service..."
        $DOCKER_CMD start "$CONTAINER_NAME" >/dev/null
        echo "[SUCCESS] Service started successfully."
    else
        echo "[ERROR] Container '$CONTAINER_NAME' does not exist."
        echo "        Please trigger CI/CD deployment or run container initialization."
        return 1
    fi
}

cmd_stop() {
    if ! is_container_running; then
        echo "[INFO] Hanoi IT Job Radar service is currently stopped."
        return 0
    fi

    echo "[INFO] Stopping Hanoi IT Job Radar service..."
    $DOCKER_CMD stop "$CONTAINER_NAME" >/dev/null
    echo "[SUCCESS] Service stopped successfully."
}

cmd_restart() {
    echo "[INFO] Restarting Hanoi IT Job Radar service..."
    $DOCKER_CMD restart "$CONTAINER_NAME" >/dev/null
    echo "[SUCCESS] Service restarted successfully."
}

cmd_status() {
    echo "=========================================================="
    echo "       HANOI IT JOB RADAR - SERVICE STATUS                "
    echo "=========================================================="
    if is_container_running; then
        echo "Status: RUNNING (Active)"
        echo ""
        echo "Resource Utilization:"
        $DOCKER_CMD stats --no-stream --format "  • Memory: {{.MemUsage}}\n  • CPU:    {{.CPUPerc}}\n  • Net IO: {{.NetIO}}" "$CONTAINER_NAME"
    elif is_container_existing; then
        echo "Status: STOPPED (Inactive)"
    else
        echo "Status: NOT FOUND"
    fi
    echo "=========================================================="
}

cmd_logs() {
    if ! is_container_existing; then
        echo "[ERROR] Container '$CONTAINER_NAME' not found."
        return 1
    fi
    echo "[INFO] Streaming service logs (Press Ctrl+C to detach)..."
    $DOCKER_CMD logs -f --tail 50 "$CONTAINER_NAME"
}

cmd_menu() {
    while true; do
        clear 2>/dev/null || true
        cmd_status
        echo ""
        echo "Available Actions:"
        echo "  [1] Start Service    (crawlerbot start)"
        echo "  [2] Stop Service     (crawlerbot stop)"
        echo "  [3] Restart Service  (crawlerbot restart)"
        echo "  [4] Stream Logs      (crawlerbot logs)"
        echo "  [5] Refresh Status   (crawlerbot status)"
        echo "  [0] Exit"
        echo "----------------------------------------------------------"
        read -r -p "Enter selection [0-5]: " choice
        case "$choice" in
            1)
                echo ""
                cmd_start
                read -r -p "Press Enter to continue..." _
                ;;
            2)
                echo ""
                cmd_stop
                read -r -p "Press Enter to continue..." _
                ;;
            3)
                echo ""
                cmd_restart
                read -r -p "Press Enter to continue..." _
                ;;
            4)
                echo ""
                cmd_logs
                ;;
            5)
                ;;
            0|q|Q)
                exit 0
                ;;
            *)
                echo "Invalid selection. Please choose [0-5]."
                sleep 1
                ;;
        esac
    done
}

case "$1" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    logs|log)
        cmd_logs
        ;;
    "")
        cmd_menu
        ;;
    *)
        echo "Usage: crawlerbot {start|stop|restart|status|logs}"
        exit 1
        ;;
esac
