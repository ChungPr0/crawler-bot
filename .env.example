# ==============================================================================
# HANOI IT JOB RADAR CONFIGURATION (.env)
# ==============================================================================

# ----------------- CHU KỲ QUÉT (SCHEDULER) -----------------
# Thời gian giữa các lần cào (tính theo phút) - Khuyến nghị: 15 đến 30 phút
CHECK_INTERVAL_MINUTES=15

# ----------------- KÊNH THÔNG BÁO DISCORD -----------------
ENABLE_DISCORD=true
# Dán URL Webhook của kênh Discord bạn muốn nhận tin:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ----------------- KÊNH THÔNG BÁO TELEGRAM ----------------
ENABLE_TELEGRAM=true
# Token bot từ @BotFather (ví dụ: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# ID của Chat cá nhân hoặc Group Telegram nhận tin (ví dụ: -100123456789 hoặc 987654321)
TELEGRAM_CHAT_ID=your_chat_id_here

# ----------------- BẬT / TẮT NGUỒN CÀO (CRAWLERS) ---------
ENABLE_ITVIEC=true
ENABLE_TOPCV=true
ENABLE_JOBGO=true
ENABLE_FACEBOOK=true

# ----------------- CẤU HÌNH CÁC NGUỒN CÀO WEB ----------------
# Link tìm kiếm ITviec (ngăn cách bằng dấu phẩy)
ITVIEC_SEARCH_ENDPOINTS=https://itviec.com/it-jobs/java/ha-noi,https://itviec.com/it-jobs/backend/ha-noi,https://itviec.com/it-jobs/frontend/ha-noi,https://itviec.com/it-jobs/devops/ha-noi

# Link tìm kiếm TopCV (ngăn cách bằng dấu phẩy)
TOPCV_SEARCH_ENDPOINTS=https://www.topcv.vn/tim-viec-lam-it-phan-mem-c10026?city=1&exp=0

# Link tìm kiếm JobsGO (ngăn cách bằng dấu phẩy)
JOBGO_SEARCH_ENDPOINTS=https://jobsgo.vn/viec-lam-cong-nghe-thong-tin-tai-ha-noi.html

# ----------------- CẤU HÌNH CÀO FACEBOOK GROUP ------------
# Đường dẫn file cookie xuất từ trình duyệt (dùng định dạng JSON chuẩn của Cookie-Editor)
FB_COOKIES_PATH=cookies/cookies.json
# Danh sách nhóm Facebook cần quét (Có thể điền tên/ID nhóm như 'internvietnam, 123456' hoặc link đầy đủ)
FB_GROUP_URLS=tuyendungitvietnam, vieclamit.hanoi, internvietnam, vieclam.itvnn
# Chạy trình duyệt Playwright ở chế độ headless (không bật GUI)
PLAYWRIGHT_HEADLESS=true

# ----------------- BỘ LỌC TỪ KHÓA (FILTER ENGINE) ---------
# (Các từ khóa ngăn cách nhau bởi dấu phẩy ',' hoặc dấu chấm phẩy ';')
# 1. Từ khóa chuyên môn (Bắt buộc khớp ít nhất 1 từ - Hỗ trợ Java, Backend, Frontend, DevOps, IT chung):
TECH_KEYWORDS=java,spring,spring boot,backend,back-end,frontend,front-end,fe,react,reactjs,vue,vuejs,angular,devops,cloud,docker,kubernetes,ci/cd,it,cntt,lập trình viên,developer,web developer,software engineer

# 2. Từ khóa cấp bậc (Bắt buộc khớp ít nhất 1 từ):
LEVEL_KEYWORDS=intern,internship,thực tập,thực tập sinh,tts,fresher,mới tốt nghiệp,năm cuối,sinh viên năm cuối,trainee

# 3. Từ khóa loại bỏ / Blacklist (Dính bất kỳ từ nào sẽ loại ngay - Chặn khóa học, hỏi han định hướng, đa cấp):
BLACKLIST_KEYWORDS=khóa học,học phí,đào tạo học viên,cam kết việc làm,học viên,triển khai phần mềm,tuyển sinh,lớp học,xin định hướng,định hướng giúp em,xin lời khuyên,hỏi mn,xin review,sv năm,sinh viên năm,tìm mentor,nhờ mn tư vấn,nhờ tư vấn,tư vấn giúp em,góp ý giúp em,cv xin việc của em,đa cấp,nhập liệu,gõ văn bản

# 4. Từ khóa địa điểm mục tiêu (Cần lấy):
LOCATION_KEYWORDS=hà nội,ha noi,hanoi,hn,cầu giấy,thanh xuân,đống đa,nam từ liêm,bắc từ liêm,ba đình,hai bà trưng,hoàng mai,hà đông,tây hồ,long biên

# 5. Tỉnh/Thành phố khác cần loại trừ (Nếu bài viết không có địa điểm mục tiêu):
EXCLUDED_LOCATIONS=hồ chí minh,ho chi minh,tphcm,tp.hcm,hcm,sài gòn,sai gon,đà nẵng,da nang,bình dương,cần thơ,hải phòng

# ----------------- HẠ TẦNG & GHI LOG ----------------------
DATABASE_PATH=data/jobs.db
LOG_DIR=logs
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
MAX_RETRIES=3
